# Forzar LF en scripts de shell para evitar errores en contenedores Linux
*.sh text eol=lf

# Normalizar otros archivos de texto
*.yml text eol=lf
*.yaml text eol=lf
*.java text eol=lf
*.json text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.js text eol=lf
*.ts text eol=lf
Dockerfile text eol=lf
